{TEXT("1972-08-04"), TEXT("≈X20"), 4, 85, TEXT("NOAA · NASA"), TEXT("Случилась между полётами «Аполлон-16» и «Аполлон-17». Будь астронавты в тот день на Луне, они получили бы опасную дозу."), TEXT("It happened between Apollo 16 and Apollo 17. Astronauts on the Moon that day would have received a dangerous dose.")},
{TEXT("1989-10-19"), TEXT("X13"), 4, 75, TEXT("NOAA"), TEXT("Одна из сильнейших протонных бурь космической эры."), TEXT("One of the strongest proton storms of the space age.")},
{TEXT("2001-11-04"), TEXT("X1.0"), 4, 70, TEXT("NOAA"), TEXT("Слабая вспышка класса X1, но огромная протонная буря. Яркость вспышки не говорит, насколько она опасна."), TEXT("Only an X1 flare, yet a huge proton storm. A flare’s brightness does not tell you how dangerous it is.")},
{TEXT("2003-10-28"), TEXT("X17"), 4, 70, TEXT("NOAA · NASA"), TEXT("«Хеллоуинские бури». Экипаж МКС укрывался в самых защищённых отсеках станции."), TEXT("The “Halloween storms”. The ISS crew sheltered in the best-protected parts of the station.")},
{TEXT("2005-01-20"), TEXT("X7.1"), 3, 45, TEXT("NOAA"), TEXT("Протоны пришли очень быстро и были очень энергичными: на подготовку почти не было времени."), TEXT("The protons arrived very fast and with very high energy, leaving almost no time to prepare.")},
{TEXT("2012-01-23"), TEXT("M8.7"), 3, 50, TEXT("NOAA · NASA DONKI"), TEXT("Вспышка даже не класса X, а буря одна из самых сильных за десятилетие."), TEXT("Not even an X-class flare, yet one of the strongest proton storms of the decade.")},
